# Web (copy to apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
OWNER_EMAIL=owner@example.com
TM_FIXTURE_MODE=true

# Ingestion (copy to services/ingest/.env)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
RAW_ARTIFACT_BUCKET=raw-artifacts
SHWOO_REQUEST_INTERVAL_SECONDS=1
