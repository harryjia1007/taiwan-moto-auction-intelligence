# Web (copy to apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
OWNER_EMAIL=owner@example.com
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@harryjia.com
INGEST_CONTACT_URL=https://harryjia.com/projects/taiwan-moto-auction
TM_FIXTURE_MODE=true

# Ingestion (copy to services/ingest/.env)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Hosted ingestion should prefer a current sb_secret_ key. The legacy service-role
# variable remains supported for local Supabase and existing environments.
SUPABASE_SECRET_KEY=
RAW_ARTIFACT_BUCKET=raw-artifacts
SHWOO_REQUEST_INTERVAL_SECONDS=1
PCC_REQUEST_INTERVAL_SECONDS=1
JUDICIAL_REQUEST_INTERVAL_SECONDS=1
MOJ_AUCTION_REQUEST_INTERVAL_SECONDS=1
MOJ_ENFORCEMENT_REQUEST_INTERVAL_SECONDS=1
